<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>FirstMaths</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Objo.Runtime.Abstractions">
      <HintPath>$(OBJO_PLUGIN_SDK_ROOT)/lib/Objo.Runtime.Abstractions.dll</HintPath>
    </Reference>
  </ItemGroup>
  <Target Name="RequirePluginSdk" BeforeTargets="ResolveReferences"
          Condition="'$(OBJO_PLUGIN_SDK_ROOT)' == ''">
    <Error Text="Set OBJO_PLUGIN_SDK_ROOT to the extracted Objo Plugin SDK directory before building." />
  </Target>
</Project>
